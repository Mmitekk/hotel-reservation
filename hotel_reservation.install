<?php

/**
 * @file
 * Install, update and uninstall functions for Hotel Reservation module.
 */

use Drupal\Core\Entity\EntityTypeInterface;

function hotel_reservation_create_default_room_types() {
  $defaults = [
    'standard' => ['label' => 'Стандарт', 'color' => '#6b7280', 'weight' => 0],
    'superior' => ['label' => 'Супериор', 'color' => '#0ea5e9', 'weight' => 1],
    'deluxe' => ['label' => 'Делюкс', 'color' => '#8b5cf6', 'weight' => 2],
    'suite' => ['label' => 'Сьют', 'color' => '#f59e0b', 'weight' => 3],
    'apartment' => ['label' => 'Апартаменты', 'color' => '#10b981', 'weight' => 4],
    'villa' => ['label' => 'Вилла', 'color' => '#ec4899', 'weight' => 5],
    'family' => ['label' => 'Семейный', 'color' => '#06b6d4', 'weight' => 6],
    'economy' => ['label' => 'Эконом', 'color' => '#64748b', 'weight' => 7],
  ];
  $storage = \Drupal::entityTypeManager()->getStorage('hr_room_type');
  foreach ($defaults as $id => $values) {
    if (!$storage->load($id)) {
      $storage->create(['id' => $id, 'label' => $values['label'], 'color' => $values['color'], 'weight' => $values['weight']])->save();
    }
  }
}

/**
 * Implements hook_install().
 */
function hotel_reservation_install(bool $is_syncing) {
  // Set default configuration values.
  \Drupal::configFactory()->getEditable('hotel_reservation.settings')
    ->set('hotel_name', \Drupal::config('system.site')->get('name'))
    ->set('currency_symbol', '₽')
    ->set('currency_code', 'RUB')
    ->set('min_stay_nights', 1)
    ->set('max_stay_nights', 30)
    ->set('check_in_time', '14:00')
    ->set('check_out_time', '12:00')
    ->set('enable_admin_notification', TRUE)
    ->set('enable_guest_confirmation', TRUE)
    ->set('reservation_expiration_hours', 24)
    ->set('booking_conditions', '')
    ->set('room_modal_width', 80)
    ->save();

  hotel_reservation_create_default_room_types();

  \Drupal::messenger()->addStatus(t('Hotel Reservation module installed successfully. Configure it at <a href=":url">Settings</a>.', [
    ':url' => \Drupal\Core\Url::fromRoute('hotel_reservation.settings')->toString(),
  ]));
}

/**
 * Add image field to hr_room.
 */
function hotel_reservation_update_10001() {
  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
  $field_storage_definition = \Drupal::service('entity_field.manager')->getFieldStorageDefinitions('hr_room')['image'] ?? NULL;
  if (!$field_storage_definition) {
    $field_storage_definition = \Drupal\Core\Field\BaseFieldDefinition::create('image')
      ->setLabel(t('Изображение (превью)'))
      ->setCardinality(1)
      ->setSettings([
        'file_directory' => 'hotel-rooms',
        'alt_field' => TRUE,
        'alt_field_required' => FALSE,
        'title_field' => FALSE,
        'max_filesize' => '2 MB',
        'file_extensions' => 'png jpg jpeg webp',
        'max_resolution' => '2000x2000',
        'min_resolution' => '200x150',
      ]);
  }
  $definition_update_manager->installFieldStorageDefinition('image', 'hr_room', 'hotel_reservation', $field_storage_definition);
}

/**
 * Create default room types.
 */
function hotel_reservation_update_10002() {
  hotel_reservation_create_default_room_types();
}

/**
 * Convert image field to media reference.
 */
function hotel_reservation_update_10003() {
  if (!\Drupal::moduleHandler()->moduleExists('media')) {
    return;
  }
  $def_manager = \Drupal::entityDefinitionUpdateManager();
  try {
    $old_def = $def_manager->getFieldStorageDefinition('image', 'hr_room');
  }
  catch (\Exception $e) {
    return;
  }
  if (!$old_def || $old_def->getType() === 'entity_reference') {
    return;
  }
  $storage = \Drupal::entityTypeManager()->getStorage('hr_room');
  $rooms = $storage->loadMultiple();
  $map = [];
  foreach ($rooms as $room) {
    $item = $room->get('image')->first();
    if ($item && !empty($item->target_id)) {
      $map[$room->id()] = ['fid' => $item->target_id, 'alt' => $item->alt ?? '', 'title' => $item->title ?? ''];
    }
  }
  $def_manager->uninstallFieldStorageDefinition($old_def);
  $new_def = \Drupal\Core\Field\BaseFieldDefinition::create('entity_reference')
    ->setLabel(t('Изображение (превью)'))
    ->setDescription(t('Превью номера. Выберите из медиа-библиотеки.'))
    ->setCardinality(1)
    ->setRequired(FALSE)
    ->setSettings([
      'target_type' => 'media',
      'handler' => 'default:media',
      'handler_settings' => [
        'target_bundles' => ['image' => 'image'],
        'sort' => ['field' => '_none'],
        'auto_create' => FALSE,
      ],
    ])
    ->setDisplayOptions('view', ['label' => 'hidden', 'type' => 'entity_reference_label', 'weight' => -4])
    ->setDisplayOptions('form', ['type' => 'media_library_widget', 'weight' => -6, 'settings' => ['media_types' => ['image']]])
    ->setDisplayConfigurable('form', TRUE)
    ->setDisplayConfigurable('view', TRUE);
  $def_manager->installFieldStorageDefinition('image', 'hr_room', 'hotel_reservation', $new_def);
  if (empty($map)) {
    return;
  }
  $media_storage = \Drupal::entityTypeManager()->getStorage('media');
  $file_storage = \Drupal::entityTypeManager()->getStorage('file');
  foreach ($map as $rid => $data) {
    $file = $file_storage->load($data['fid']);
    if (!$file) {
      continue;
    }
    $file->setPermanent();
    $file->save();
    try {
      $media = $media_storage->create([
        'bundle' => 'image',
        'name' => $file->getFilename(),
        'field_media_image' => ['target_id' => $file->id(), 'alt' => $data['alt'], 'title' => $data['title']],
        'status' => 1,
      ]);
      $media->save();
      $room = $storage->load($rid);
      if ($room) {
        $room->set('image', ['target_id' => $media->id()]);
        $room->save();
      }
    }
    catch (\Exception $e) {
      \Drupal::logger('hotel_reservation')->error('Image migration failed for room @id: @msg', ['@id' => $rid, '@msg' => $e->getMessage()]);
    }
  }
}

/**
 * Ensures teaser + gallery images storage exists on hr_room.
 *
 * NOTE: must check INSTALLED definitions via entityDefinitionUpdateManager,
 * not entity_field.manager (which also returns code-defined base fields
 * and would wrongly report the storage as existing).
 */
function hotel_reservation_ensure_room_gallery_fields() {
  $def_manager = \Drupal::entityDefinitionUpdateManager();
  $schema = \Drupal::database()->schema();
  $has_teaser = $schema->fieldExists('hr_room', 'teaser__value') || $schema->fieldExists('hr_room', 'teaser');
  $has_images = $schema->tableExists('hr_room__images');
  if (empty($has_teaser)) {
    $teaser = \Drupal\Core\Field\BaseFieldDefinition::create('string_long')
      ->setLabel(t('Анонс (краткое описание)'))
      ->setDescription(t('Показывается в карточке «Наши номера».'))
      ->setDefaultValue('')
      ->setRequired(FALSE)
      ->setDisplayOptions('view', ['label' => 'above', 'type' => 'basic_string', 'weight' => -1])
      ->setDisplayOptions('form', ['type' => 'string_textarea', 'weight' => -1, 'settings' => ['rows' => 2]])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
    $def_manager->installFieldStorageDefinition('teaser', 'hr_room', 'hotel_reservation', $teaser);
  }
  if (empty($has_images)) {
    $images = \Drupal\Core\Field\BaseFieldDefinition::create('entity_reference')
      ->setLabel(t('Слайдер (изображения номера)'))
      ->setCardinality(-1)
      ->setRequired(FALSE)
      ->setSettings([
        'target_type' => 'media',
        'handler' => 'default:media',
        'handler_settings' => [
          'target_bundles' => ['image' => 'image'],
          'sort' => ['field' => '_none'],
          'auto_create' => FALSE,
        ],
      ])
      ->setDisplayOptions('view', ['label' => 'hidden', 'type' => 'entity_reference_label', 'weight' => -3])
      ->setDisplayOptions('form', ['type' => 'media_library_widget', 'weight' => -5, 'settings' => ['media_types' => ['image']]])
      ->setDisplayConfigurable('form', TRUE)
      ->setDisplayConfigurable('view', TRUE);
    $def_manager->installFieldStorageDefinition('images', 'hr_room', 'hotel_reservation', $images);
  }
  $config = \Drupal::configFactory()->getEditable('hotel_reservation.settings');
  if ($config->get('room_modal_width') === NULL) {
    $config->set('room_modal_width', 80)->save();
  }
}

/**
 * Add teaser + gallery images to hr_room.
 */
function hotel_reservation_update_10004() {
  hotel_reservation_ensure_room_gallery_fields();
}

/**
 * Re-run gallery fields install (10004 checked code definitions instead of
 * installed storage and could skip table creation).
 */
function hotel_reservation_update_10005() {
  hotel_reservation_ensure_room_gallery_fields();
}

/**
 * Implements hook_uninstall().
 */
function hotel_reservation_uninstall(bool $is_syncing) {
  // Delete all configuration.
  \Drupal::configFactory()->getEditable('hotel_reservation.settings')->delete();
  \Drupal::messenger()->addStatus(t('Hotel Reservation module has been uninstalled. All data remains in the database.'));
}
