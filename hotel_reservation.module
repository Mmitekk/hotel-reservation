/**
 * Implements hook_ENTITY_TYPE_access() for hr_reservation entities.
 *
 * Grants the hotel_client role read-only access to reservations.
 */
function hotel_reservation_hr_reservation_access(EntityInterface $entity, $operation, AccountInterface $account) {
  if ($operation === 'view') {
    return AccessResult::allowedIfHasPermission($account, 'view hotel reservations');
  }
  return AccessResult::neutral();
}

/**
 * Implements hook_cron().
 */
function hotel_reservation_cron() {
  // Auto-cancel expired pending reservations.
  $config = \Drupal::config('hotel_reservation.settings');
  $expiration_hours = $config->get('reservation_expiration_hours') ?: 24;

  $query = \Drupal::entityTypeManager()->getStorage('hr_reservation')->getQuery()
    ->condition('status', 'pending')
    ->condition('created', strtotime("-{$expiration_hours} hours"), '<')
    ->accessCheck(FALSE);

  $ids = $query->execute();
  if (!empty($ids)) {
    $reservations = \Drupal::entityTypeManager()->getStorage('hr_reservation')->loadMultiple($ids);
    foreach ($reservations as $reservation) {
      $reservation->set('status', 'expired');
      $reservation->save();
    }
    \Drupal::logger('hotel_reservation')->notice(t('Auto-expired @count pending reservation(s).', ['@count' => count($ids)]));
  }
}

/**
 * Implements hook_mail().
 */
function hotel_reservation_mail($key, &$message, $params) {
  switch ($key) {
    case 'reservation_confirmation':
      $message['subject'] = t('Подтверждение бронирования — @hotel', [
        '@hotel' => \Drupal::config('system.site')->get('name'),
      ]);
      $message['body'][] = $params['message'];
      break;

    case 'reservation_admin_notification':
      $message['subject'] = t('Новое бронирование от @guest', [
        '@guest' => $params['guest_name'],
      ]);
      $message['body'][] = $params['message'];
      break;
  }
}

/**
 * Get available rooms for given dates.
 *
 * @param string $check_in
 *   Check-in date string (Y-m-d).
 * @param string $check_out
 *   Check-out date string (Y-m-d).
 * @param int $guests_count
 *   Number of guests.
 *
 * @return array
 *   Array of available room entities.
 */
function hotel_reservation_get_available_rooms($check_in, $check_out, $guests_count = 1) {
  $room_storage = \Drupal::entityTypeManager()->getStorage('hr_room');

  // Get all active rooms with enough capacity.
  $query = $room_storage->getQuery()
    ->condition('status', 1)
    ->condition('capacity', $guests_count, '>=')
    ->accessCheck(FALSE);

  $room_ids = $query->execute();

  if (empty($room_ids)) {
    return [];
  }

  $all_rooms = $room_storage->loadMultiple($room_ids);
  $available_rooms = [];

  // Get all reservations that overlap with the requested period.
  // Note: For date-only datetime fields, Drupal stores values as just the
  // date string (Y-m-d) without a time component, so Y-m-d string comparison
  // against the check_in/check_out values works correctly here.
  $reservation_storage = \Drupal::entityTypeManager()->getStorage('hr_reservation');
  $res_query = $reservation_storage->getQuery()
    ->condition('status', ['pending', 'confirmed', 'checked_in'], 'IN')
    ->condition('check_in', $check_out, '<')
    ->condition('check_out', $check_in, '>')
    ->accessCheck(FALSE);

  $conflicting_reservation_ids = $res_query->execute();
  $conflicting_rooms = [];

  if (!empty($conflicting_reservation_ids)) {
    $conflicting_reservations = $reservation_storage->loadMultiple($conflicting_reservation_ids);
    foreach ($conflicting_reservations as $reservation) {
      $conflicting_rooms[] = $reservation->get('room_id')->target_id;
    }
  }

  // Filter out rooms with conflicting reservations.
  foreach ($all_rooms as $room) {
    if (!in_array($room->id(), $conflicting_rooms)) {
      $available_rooms[$room->id()] = $room;
    }
  }

  return $available_rooms;
}

/**
 * Returns allowed values for room_type field (dynamic from hr_room_type config).
 *
 * @return string[]
 */
function hotel_reservation_room_type_allowed_values(): array {
  $fallback = [
    'standard' => t('Стандарт'),
    'superior' => t('Супериор'),
    'deluxe' => t('Делюкс'),
    'suite' => t('Сьют'),
    'apartment' => t('Апартаменты'),
    'villa' => t('Вилла'),
    'family' => t('Семейный'),
    'economy' => t('Эконом'),
  ];
  try {
    $storage = \Drupal::entityTypeManager()->getStorage('hr_room_type');
    $types = $storage->loadMultiple();
    if (!empty($types)) {
      uasort($types, function ($a, $b) {
        return $a->getWeight() <=> $b->getWeight();
      });
      $allowed = [];
      foreach ($types as $type) {
        $allowed[$type->id()] = $type->label();
      }
      return $allowed;
    }
  }
  catch (\Exception $e) {
  }
  return $fallback;
}

/**
 * Implements hook_preprocess_block().
 *
 * Adds .page-content-section class to the block wrapper when the block's
 * 'use_page_content_section' configuration is enabled. This ensures the
 * class wraps BOTH the block title and content (not just the content).
 */
function hotel_reservation_preprocess_block(&$variables) {
  $plugin_id = $variables['elements']['#plugin_id'] ?? '';
  $our_blocks = [
    'hotel_reservation_booking_form',
    'hotel_reservation_rooms',
    'hotel_reservation_room_comparison',
  ];

  if (!in_array($plugin_id, $our_blocks)) {
    return;
  }

  $configuration = $variables['elements']['#configuration'] ?? [];
  if (!empty($configuration['use_page_content_section'])) {
    $variables['attributes']['class'][] = 'page-content-section';
  }
  if (!empty($configuration['use_block_spacing'])) {
    $variables['attributes']['class'][] = 'hr-block-spacing';
  }
}

/**
 * Calculate total price for a room for given dates.
 *
 * @param int $room_id
 *   The room entity ID.
 * @param string $check_in
 *   Check-in date string (Y-m-d).
 * @param string $check_out
 *   Check-out date string (Y-m-d).
 *
 * @return array
 *   Associative array with 'total', 'nights', 'daily_prices'.
 */
function hotel_reservation_calculate_price($room_id, $check_in, $check_out) {
  $room = \Drupal::entityTypeManager()->getStorage('hr_room')->load($room_id);
  if (!$room) {
    return ['total' => 0, 'nights' => 0, 'daily_prices' => []];
  }

  $base_price = (float) $room->get('base_price')->value;
  $start = new \DateTime($check_in);
  $end = new \DateTime($check_out);
  $interval = $start->diff($end);
  $nights = $interval->days;

  if ($nights <= 0) {
    return ['total' => 0, 'nights' => 0, 'daily_prices' => []];
  }

  // Load custom pricing for this room.
  $pricing_storage = \Drupal::entityTypeManager()->getStorage('hr_room_pricing');
  $pricing_query = $pricing_storage->getQuery()
    ->condition('room_id', $room_id)
    ->condition('date', [$check_in, (clone $end)->modify('-1 day')->format('Y-m-d')], 'BETWEEN')
    ->accessCheck(FALSE);

  $pricing_ids = $pricing_query->execute();
  $custom_prices = [];

  if (!empty($pricing_ids)) {
    $pricings = $pricing_storage->loadMultiple($pricing_ids);
    foreach ($pricings as $pricing) {
      $date_value = $pricing->get('date')->value;
      // Extract just the date portion (Y-m-d) from datetime value.
      if (strlen($date_value) > 10) {
        $date_value = substr($date_value, 0, 10);
      }
      $custom_prices[$date_value] = (float) $pricing->get('price')->value;
    }
  }

  $daily_prices = [];
  $total = 0;
  $current = clone $start;

  for ($i = 0; $i < $nights; $i++) {
    $date_str = $current->format('Y-m-d');
    $price = isset($custom_prices[$date_str]) ? $custom_prices[$date_str] : $base_price;
    $daily_prices[$date_str] = $price;
    $total += $price;
    $current->modify('+1 day');
  }

  return [
    'total' => $total,
    'nights' => $nights,
    'daily_prices' => $daily_prices,
    'base_price' => $base_price,
  ];
}

/**
 * Returns the default text of a notification email.
 *
 * Available tokens: @guest, @email, @phone, @room, @check_in, @check_out,
 * @count, @total, @currency, @notes, @hotel.
 *
 * @param string $key
 *   One of: admin_new_booking, guest_pending, guest_confirmed.
 *
 * @return string
 *   The default email body with tokens.
 */
function hotel_reservation_default_mail_text(string $key): string {
  switch ($key) {
    case 'admin_new_booking':
      return "Создано новое бронирование через сайт:\n\nГость: @guest\nEmail: @email\nТелефон: @phone\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\nГости: @count\nИтого: @total @currency\nЗаметки: @notes";

    case 'guest_pending':
      return "Уважаемый(ая) @guest,\n\nВаша заявка на бронирование в отеле @hotel получена и ожидает подтверждения.\n\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\nГости: @count\nИтого: @total @currency\n\nВы получите подтверждение после обработки заявки.\n\nС уважением,\n@hotel";

    case 'guest_confirmed':
      return "Уважаемый(ая) @guest,\n\nВаше бронирование в отеле @hotel подтверждено!\n\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\nИтого: @total @currency\n\nЖдём вас!\n\nС уважением,\n@hotel";

    default:
      return '';
  }
}

/**
 * Builds a notification email body from a template with tokens.
 *
 * @param string $template
 *   Template text with @tokens.
 * @param array $tokens
 *   Token values keyed by token name without @.
 *
 * @return string
 *   The template with tokens replaced.
 */
function hotel_reservation_build_mail_text(string $template, array $tokens): string {
  $replace = [];
  foreach ($tokens as $name => $value) {
    $replace['@' . $name] = (string) $value;
  }
  return strtr($template, $replace);
}

/**
 * Returns the configured (or default) text of a notification email.
 *
 * @param string $key
 *   One of: admin_new_booking, guest_pending, guest_confirmed.
 *
 * @return string
 *   The email body template with tokens.
 */
function hotel_reservation_get_mail_text(string $key): string {
  $map = [
    'admin_new_booking' => 'mail_admin_new_booking',
    'guest_pending' => 'mail_guest_pending',
    'guest_confirmed' => 'mail_guest_confirmed',
  ];
  if (!isset($map[$key])) {
    return '';
  }
  $stored = \Drupal::config('hotel_reservation.settings')->get($map[$key]);
  if (is_string($stored) && trim($stored) !== '') {
    return $stored;
  }
  return hotel_reservation_default_mail_text($key);
}
