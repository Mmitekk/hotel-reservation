{#
  @file
  Dashboard template v1.2 — adds weekly revenue chart and export button.

  Variables:
  - stats: total_rooms, published_rooms, total_reservations, pending_reservations,
    confirmed_reservations, checked_in_reservations, total_revenue, avg_occupancy.
  - pending_reservations: [id, guest_name, room_name, check_in, check_out, total_price, created, confirm_url, cancel_url]
  - upcoming_checkins: [id, guest_name, room_name, check_in]
  - currency: e.g. "₽"
  - weekly_revenue: [{day: "Mon", day_short: "Пн", amount: 5000}, ...] (7 items, Mon-Sun)
  - weekly_total: formatted total string
  - export_url: URL to CSV export
  - can_manage: TRUE for full admins (shows export links and action buttons)
#}

<div class="hr-dashboard-wrapper">

  {# === STAT CARDS GRID === #}
  <div class="hr-dashboard-grid">
    <div class="hr-dashboard-card hr-dashboard-card--rooms">
      <div class="hr-dashboard-card__icon">🏨</div>
      <div class="hr-dashboard-card__body">
        <div class="hr-dashboard-card__label">{{ 'Номера'|t }}</div>
        <div class="hr-dashboard-card__value">{{ stats.published_rooms }}</div>
        <div class="hr-dashboard-card__trend">{{ 'из @total создано'|t({'@total': stats.total_rooms }) }}</div>
      </div>
    </div>

    <div class="hr-dashboard-card hr-dashboard-card--pending">
      <div class="hr-dashboard-card__icon">⏳</div>
      <div class="hr-dashboard-card__body">
        <div class="hr-dashboard-card__label">{{ 'Ожидают'|t }}</div>
        <div class="hr-dashboard-card__value">{{ stats.pending_reservations }}</div>
        <div class="hr-dashboard-card__trend">{{ 'из @total всего'|t({'@total': stats.total_reservations }) }}</div>
      </div>
    </div>

    <div class="hr-dashboard-card hr-dashboard-card--revenue">
      <div class="hr-dashboard-card__icon">💰</div>
      <div class="hr-dashboard-card__body">
        <div class="hr-dashboard-card__label">{{ 'Доход'|t }}</div>
        <div class="hr-dashboard-card__value">{{ stats.total_revenue }} {{ currency }}</div>
        <div class="hr-dashboard-card__trend">{{ stats.confirmed_reservations }} {{ 'подтверждено'|t }}, {{ stats.checked_in_reservations }} {{ 'заселено'|t }}</div>
      </div>
    </div>

    <div class="hr-dashboard-card hr-dashboard-card--checkins">
      <div class="hr-dashboard-card__icon">🔑</div>
      <div class="hr-dashboard-card__body">
        <div class="hr-dashboard-card__label">{{ 'Заезды (3 дн.)'|t }}</div>
        <div class="hr-dashboard-card__value">{{ upcoming_checkins|length }}</div>
        <div class="hr-dashboard-card__trend">{{ 'Загрузка: @pct%'|t({'@pct': stats.avg_occupancy }) }}</div>
      </div>
    </div>
  </div>

  {# === WEEKLY REVENUE CHART === #}
  {% if weekly_revenue is not empty %}
  <div class="hr-dashboard-section">
      <div class="hr-dashboard-section__title">
        {{ 'Доход за неделю'|t }}
        {% if can_manage %}
        <a href="{{ export_url }}" class="hr-dashboard-btn hr-dashboard-btn--export">📥 {{ 'Экспорт CSV'|t }}</a>
        {% endif %}
      </div>
      <div class="hr-dash-chart">
        <div class="hr-dash-chart__bars">
          {% for day in weekly_revenue %}
            {% set bar_height = day.height_pct ~ '%' %}
            <div class="hr-dash-chart__bar-col">
              <div class="hr-dash-chart__bar{% if day.amount == 0 %} hr-dash-chart__bar--empty{% endif %}"
                   style="height: {{ bar_height }}"
                   data-amount="{{ day.formatted_amount }}">
              </div>
              <span class="hr-dash-chart__day{% if day.is_today %} hr-dash-chart__day--today{% endif %}">{{ day.day_short }}</span>
            </div>
          {% endfor %}
        </div>
        <div class="hr-dash-chart__total">
          <span class="hr-dash-chart__total-label">{{ 'Итого за неделю'|t }}</span>
          <span class="hr-dash-chart__total-value">{{ weekly_total }} {{ currency }}</span>
        </div>
      </div>
    </div>
  {% endif %}

  {# === PENDING RESERVATIONS TABLE === #}
  <div class="hr-dashboard-section">
    <div class="hr-dashboard-section__title">
      {{ 'Ожидающие бронирования'|t }}
      {% if can_manage and export_url %}
        <a href="{{ export_url }}" class="hr-dashboard-btn hr-dashboard-btn--export">📥 {{ 'Экспорт всё'|t }}</a>
      {% endif %}
    </div>
    {% if pending_reservations is not empty %}
      <table class="hr-dashboard-table">
        <thead>
          <tr>
            <th>{{ 'Гость'|t }}</th>
            <th>{{ 'Номер'|t }}</th>
            <th>{{ 'Заезд'|t }}</th>
            <th>{{ 'Выезд'|t }}</th>
            <th>{{ 'Сумма'|t }}</th>
            <th>{{ 'Создано'|t }}</th>
            {% if can_manage %}<th>{{ 'Действия'|t }}</th>{% endif %}
          </tr>
        </thead>
        <tbody>
          {% for res in pending_reservations %}
            <tr class="hr-dashboard-table__row">
              <td class="hr-dashboard-table__cell hr-dashboard-table__cell--guest">{{ res.guest_name }}</td>
              <td class="hr-dashboard-table__cell">{{ res.room_name }}</td>
              <td class="hr-dashboard-table__cell hr-dashboard-table__cell--date">{{ res.check_in }}</td>
              <td class="hr-dashboard-table__cell hr-dashboard-table__cell--date">{{ res.check_out }}</td>
              <td class="hr-dashboard-table__cell hr-dashboard-table__cell--price">{{ res.total_price }} {{ currency }}</td>
              <td class="hr-dashboard-table__cell hr-dashboard-table__cell--date">{{ res.created }}</td>
              {% if can_manage %}
              <td class="hr-dashboard-table__cell hr-dashboard-table__cell--actions">
                <a href="{{ res.confirm_url }}" class="hr-dashboard-btn hr-dashboard-btn--confirm">{{ 'Подтвердить'|t }}</a>
                <a href="{{ res.cancel_url }}" class="hr-dashboard-btn hr-dashboard-btn--cancel">{{ 'Отменить'|t }}</a>
              </td>
              {% endif %}
            </tr>
          {% endfor %}
        </tbody>
      </table>
    {% else %}
      <p class="hr-dashboard-empty">{{ 'Нет ожидающих бронирований. Все обработаны!'|t }} ✅</p>
    {% endif %}
  </div>

  {# === UPCOMING CHECK-INS === #}
  <div class="hr-dashboard-section">
    <h2 class="hr-dashboard-section__title">🔑 {{ 'Предстоящие заезды (3 дня)'|t }}</h2>
    {% if upcoming_checkins is not empty %}
      <div class="hr-dashboard-checkins">
        {% for checkin in upcoming_checkins %}
          <div class="hr-dashboard-checkin-card">
            <div class="hr-dashboard-checkin-card__date">
              <span class="hr-dashboard-checkin-card__date-icon">📅</span>
              <span class="hr-dashboard-checkin-card__date-text">{{ checkin.check_in }}</span>
            </div>
            <div class="hr-dashboard-checkin-card__info">
              <span class="hr-dashboard-checkin-card__guest">{{ checkin.guest_name }}</span>
              <span class="hr-dashboard-checkin-card__room">→ {{ checkin.room_name }}</span>
            </div>
          </div>
        {% endfor %}
      </div>
    {% else %}
      <p class="hr-dashboard-empty">{{ 'Нет предстоящих заездов в ближайшие 3 дня.'|t }}</p>
    {% endif %}
  </div>

</div>
