{#
  @file
  Print-friendly reservation details / check-in slip template.
  Variables:
    - reservation: the hr_reservation entity
    - room: the hr_room entity
    - currency: currency symbol from settings
    - hotel_name: hotel name from settings
    - check_in_time / check_out_time: times from settings
#}

{{ attach_library('hotel_reservation/admin-styles') }}

<div class="hr-res-view">
  <div class="hr-res-view__header">
    <div class="hr-res-view__logo">{{ hotel_name }}</div>
    <div class="hr-res-view__subtitle">{{ 'Reservation Voucher'|t }} #{{ reservation.id.value }}</div>
  </div>

  <div class="hr-res-view__grid">
    <div class="hr-res-view__col">
      <div class="hr-res-view__section">
        <h3 class="hr-res-view__section-title">{{ 'Guest Information'|t }}</h3>
        <div class="hr-res-view__field">
          <span class="hr-res-view__label">{{ 'Full Name'|t }}</span>
          <span class="hr-res-view__value">{{ reservation.guest_name.value }}</span>
        </div>
        <div class="hr-res-view__field">
          <span class="hr-res-view__label">{{ 'Phone'|t }}</span>
          <span class="hr-res-view__value">{{ reservation.guest_phone.value }}</span>
        </div>
        {% if reservation.guest_email.value %}
        <div class="hr-res-view__field">
          <span class="hr-res-view__label">{{ 'Email'|t }}</span>
          <span class="hr-res-view__value">{{ reservation.guest_email.value }}</span>
        </div>
        {% endif %}
        <div class="hr-res-view__field">
          <span class="hr-res-view__label">{{ 'Guests'|t }}</span>
          <span class="hr-res-view__value">{{ reservation.guest_count.value }}</span>
        </div>
      </div>
    </div>

    <div class="hr-res-view__col">
      <div class="hr-res-view__section">
        <h3 class="hr-res-view__section-title">{{ 'Booking Details'|t }}</h3>
        <div class="hr-res-view__field">
          <span class="hr-res-view__label">{{ 'Room'|t }}</span>
          <span class="hr-res-view__value">{{ room.label }}</span>
        </div>
        <div class="hr-res-view__field">
          <span class="hr-res-view__label">{{ 'Check-in'|t }}</span>
          <span class="hr-res-view__value">{{ check_in_time }}</span>
        </div>
        <div class="hr-res-view__field">
          <span class="hr-res-view__label">{{ 'Check-out'|t }}</span>
          <span class="hr-res-view__value">{{ check_out_time }}</span>
        </div>
        <div class="hr-res-view__field">
          <span class="hr-res-view__label">{{ 'Status'|t }}</span>
          <span class="hr-res-view__value hr-res-view__status hr-res-view__status--{{ reservation.status.value }}">{{ reservation.getStatusLabel() }}</span>
        </div>
      </div>
    </div>

    <div class="hr-res-view__col hr-res-view__col--price">
      <div class="hr-res-view__price-box">
        <div class="hr-res-view__price-label">{{ 'Total Amount'|t }}</div>
        <div class="hr-res-view__price-value">{{ reservation.total_price.value }} {{ currency }}</div>
      </div>
    </div>
  </div>

  {% if reservation.notes.value %}
  <div class="hr-res-view__notes">
    <h3 class="hr-res-view__section-title">{{ 'Guest Notes'|t }}</h3>
    <p>{{ reservation.notes.value }}</p>
  </div>
  {% endif %}

  <div class="hr-res-view__footer">
    <p>{{ 'Created: @date'|t({'@date': reservation.created.value|date('d.m.Y H:i') }) }}</p>
  </div>
</div>

<style>
@media print {
  .hr-res-view { box-shadow: none !important; }
}
</style>
