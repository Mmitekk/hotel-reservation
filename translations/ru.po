# ============================================================================
# Settings form — Hotel Information fields
# ============================================================================

msgid "Hotel Name"
msgstr "Название отеля"

msgid "The hotel name used in emails and notifications. Leave blank to use the site name."
msgstr "Название отеля, используемое в письмах и уведомлениях. Оставьте пустым, чтобы использовать название сайта."

msgid "Currency Symbol"
msgstr "Символ валюты"

msgid "The symbol displayed next to prices (e.g. \u20bd, $, \u20ac)."
msgstr "Символ, отображаемый рядом с ценами (напр. \u20bd, $, \u20ac)."

msgid "Currency Code"
msgstr "Код валюты"

msgid "ISO 4217 currency code (e.g. RUB, USD, EUR)."
msgstr "Код валюты ISO 4217 (напр. RUB, USD, EUR)."

# ============================================================================
# Settings form — Booking Rules fields
# ============================================================================

msgid "Minimum Stay (nights)"
msgstr "Минимальное проживание (ночей)"

msgid "The minimum number of nights for a reservation."
msgstr "Минимальное количество ночей для бронирования."

msgid "Maximum Stay (nights)"
msgstr "Максимальное проживание (ночей)"

msgid "The maximum number of nights for a reservation."
msgstr "Максимальное количество ночей для бронирования."

msgid "Standard Check-in Time"
msgstr "Стандартное время заезда"

msgid "The standard check-in time displayed to guests (e.g. 14:00)."
msgstr "Стандартное время заезда, отображаемое для гостей (напр. 14:00)."

msgid "Standard Check-out Time"
msgstr "Стандартное время выезда"

msgid "The standard check-out time displayed to guests (e.g. 12:00)."
msgstr "Стандартное время выезда, отображаемое для гостей (напр. 12:00)."

msgid "Booking Conditions"
msgstr "Условия бронирования"

msgid "The terms and conditions displayed on the booking form. Leave blank to use the default."
msgstr "Правила и условия, отображаемые на форме бронирования. Оставьте пустым для использования по умолчанию."

# ============================================================================
# Settings form — Notifications fields
# ============================================================================

msgid "Enable Admin Notification"
msgstr "Включить уведомления администратора"

msgid "Send an email to the administrator when a new reservation is created."
msgstr "Отправлять письмо администратору при создании нового бронирования."

msgid "Admin Notification Email"
msgstr "Эл. почта для уведомлений администратора"

msgid "The email address to receive new reservation notifications. Leave blank to disable admin notifications."
msgstr "Адрес электронной почты для получения уведомлений о новых бронированиях. Оставьте пустым, чтобы отключить уведомления."

msgid "Enable Guest Confirmation Email"
msgstr "Включить подтверждение по эл. почте для гостя"

msgid "Send a confirmation email to the guest when their reservation is confirmed."
msgstr "Отправлять письмо с подтверждением гостю при подтверждении его бронирования."

# ============================================================================
# Settings form — Automation fields
# ============================================================================

msgid "Reservation Expiration (hours)"
msgstr "Срок действия бронирования (часы)"

msgid "Pending (unconfirmed) reservations will automatically be set to expired after this many hours. Checked during cron runs."
msgstr "Неподтверждённые бронирования будут автоматически помечены как истёкшие по истечении указанного количества часов. Проверяется при запуске cron."

# ============================================================================
# Settings form — Booking Form Design fields
# ============================================================================

msgid "Form Title"
msgstr "Заголовок формы"

msgid "Leave blank to use hotel name."
msgstr "Оставьте пустым, чтобы использовать название отеля."

msgid "Form Subtitle"
msgstr "Подзаголовок формы"

msgid "Text below the title. Leave blank for default (check-in/out times)."
msgstr "Текст под заголовком. Оставьте пустым для значения по умолчанию (время заезда/выезда)."

msgid "Submit Button Text"
msgstr "Текст кнопки отправки"

msgid "Primary Color"
msgstr "Основной цвет"

msgid "Main color for buttons and accents."
msgstr "Основной цвет для кнопок и акцентов."

msgid "Background Color"
msgstr "Цвет фона"

msgid "Form background color."
msgstr "Цвет фона формы."

msgid "Text Color"
msgstr "Цвет текста"

msgid "Main text color."
msgstr "Основной цвет текста."

msgid "Border Radius (px)"
msgstr "Радиус скругления (пикс.)"

msgid "Roundness of form elements."
msgstr "Скругление элементов формы."

msgid "Success Message Title"
msgstr "Заголовок сообщения об успешной отправке"

msgid "Success Message Text"
msgstr "Текст сообщения об успешной отправке"

msgid "Use @id placeholder for reservation number."
msgstr "Используйте заполнитель @id для номера бронирования."

# ============================================================================
# Settings form — validation messages
# ============================================================================

msgid "Maximum stay cannot be less than minimum stay."
msgstr "Максимальное проживание не может быть меньше минимального."

msgid "Check-in time must be in HH:MM format."
msgstr "Время заезда должно быть в формате ЧЧ:ММ."

msgid "Check-in time is not valid."
msgstr "Время заезда недействительно."

msgid "Check-out time must be in HH:MM format."
msgstr "Время выезда должно быть в формате ЧЧ:ММ."

msgid "Check-out time is not valid."
msgstr "Время выезда недействительно."

msgid "Admin notification email is required when admin notifications are enabled."
msgstr "Адрес электронной почты администратора обязателен, если уведомления включены."

