msgid "\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u2014 @hotel"
msgstr "Подтверждение бронирования \u2014 @hotel"

msgid "\u041d\u043e\u0432\u043e\u0435 \u0431\u0440\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043e\u0442 @guest"
msgstr "Новое бронирование от @guest"

msgid "Dear @guest,\n\nYour reservation at @hotel has been confirmed.\n\nRoom: @room\nCheck-in: @check_in\nCheck-out: @check_out\nTotal: @total @currency\n\nWe look forward to your stay!\n\nBest regards,\n@hotel"
msgstr "Уважаемый(ая) @guest,\n\nВаше бронирование в @hotel подтверждено.\n\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\nИтого: @total @currency\n\nЖдём вас!\n\nС уважением,\n@hotel"

msgid "A new reservation has been created:\n\nGuest: @guest\nEmail: @email\nPhone: @phone\nRoom: @room\nCheck-in: @check_in\nCheck-out: @check_out\nGuests: @count\nTotal: @total @currency\n\nStatus: @status"
msgstr "Создано новое бронирование:\n\nГость: @guest\nЭл. почта: @email\nТелефон: @phone\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\nГости: @count\nИтого: @total @currency\n\nСтатус: @status"

msgid "Dear @guest,\n\nYour reservation at @hotel has been confirmed!\n\nRoom: @room\nCheck-in: @check_in\nCheck-out: @check_out\nTotal: @total @currency\n\nWe look forward to your stay!\n\nBest regards,\n@hotel"
msgstr "Уважаемый(ая) @guest,\n\nВаше бронирование в @hotel подтверждено!\n\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\nИтого: @total @currency\n\nЖдём вас!\n\nС уважением,\n@hotel"

msgid "A reservation has been cancelled:\n\nGuest: @guest\nRoom: @room\nCheck-in: @check_in\nCheck-out: @check_out\n\nStatus: Cancelled"
msgstr "Бронирование отменено:\n\nГость: @guest\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\n\nСтатус: Отменено"

msgid "A new reservation has been created via the website:\n\nGuest: @guest\nEmail: @email\nPhone: @phone\nRoom: @room\nCheck-in: @check_in\nCheck-out: @check_out\nGuests: @count\nTotal: @total @currency\nNotes: @notes"
msgstr "Создано новое бронирование через сайт:\n\nГость: @guest\nЭл. почта: @email\nТелефон: @phone\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\nГости: @count\nИтого: @total @currency\nЗаметки: @notes"

msgid "Dear @guest,\n\nYour reservation at @hotel has been received and is pending confirmation.\n\nRoom: @room\nCheck-in: @check_in\nCheck-out: @check_out\nGuests: @count\nTotal: @total @currency\n\nYou will receive a confirmation once your booking is approved.\n\nBest regards,\n@hotel"
msgstr "Уважаемый(ая) @guest,\n\nВаше бронирование в @hotel получено и ожидает подтверждения.\n\nНомер: @room\nЗаезд: @check_in\nВыезд: @check_out\nГости: @count\nИтого: @total @currency\n\nВы получите подтверждение после одобрения бронирования.\n\nС уважением,\n@hotel"

