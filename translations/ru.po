msgstr "Адрес электронной почты гостя."

msgid "Guest Count"
msgstr "Количество гостей"

msgid "The number of guests."
msgstr "Количество гостей."

msgid "Status"
msgstr "Статус"

msgid "The current status of the reservation."
msgstr "Текущий статус бронирования."

msgid "Total Price"
msgstr "Итого"

msgid "The total price for the entire reservation."
msgstr "Общая стоимость за всё время бронирования."

msgid "Guest Notes"
msgstr "Заметки гостя"

msgid "Notes or comments from the guest."
msgstr "Заметки или комментарии от гостя."

msgid "Admin Notes"
msgstr "Заметки администратора"

msgid "Internal notes visible only to administrators."
msgstr "Внутренние заметки, видимые только администраторам."

msgid "Check-in Date"
msgstr "Дата заезда"

msgid "The date the guest will check in."
msgstr "Дата заезда гостя."

msgid "Check-out Date"
msgstr "Дата выезда"

msgid "The date the guest will check out."
msgstr "Дата выезда гостя."

msgid "The time the reservation was created."
msgstr "Время создания бронирования."

msgid "The time the reservation was last edited."
msgstr "Время последнего редактирования бронирования."

msgid "Room"
msgstr "Номер"

msgid "The room this reservation is for."
msgstr "Номер, на которое оформлено бронирование."

msgid "This value is auto-calculated from the room, check-in, and check-out dates."
msgstr "Это значение автоматически рассчитывается на основе номера, дат заезда и выезда."

msgid "Reservation for @guest"
msgstr "Бронирование для @guest"

msgid "Reservation for %guest has been created."
msgstr "Бронирование для %guest создано."

msgid "Reservation for %guest has been saved."
msgstr "Бронирование для %guest сохранено."

