# ============================================================================
# Room entity — field labels & descriptions
# ============================================================================

msgid "Room Name"
msgstr "Название номера"

msgid "The name of the room."
msgstr "Название номера."

msgid "Description"
msgstr "Описание"

msgid "A detailed description of the room."
msgstr "Подробное описание номера."

msgid "Room Type"
msgstr "Тип номера"

msgid "The category or type of the room."
msgstr "Категория или тип номера."

msgid "Capacity"
msgstr "Вместимость"

msgid "The maximum number of guests the room can accommodate."
msgstr "Максимальное количество гостей, которых может разместить номер."

msgid "Base Price per Night"
msgstr "Базовая цена за ночь"

msgid "The base price per night in the default currency."
msgstr "Базовая цена за ночь в валюте по умолчанию."

msgid "Amenities"
msgstr "Удобства"

msgid "A comma-separated list of amenity names (e.g. WiFi, TV, Minibar)."
msgstr "Список удобств через запятую (напр. Wi-Fi, ТВ, Мини-бар)."

msgid "Published"
msgstr "Опубликовано"

msgid "Whether the room is published and available for booking."
msgstr "Опубликован ли номер и доступен для бронирования."

msgid "Sort Weight"
msgstr "Вес сортировки"

msgid "The weight of this room for ordering in lists. Lower values appear first."
msgstr "Вес этого номера для сортировки в списках. Меньшие значения отображаются первыми."

msgid "Created"
msgstr "Создано"

msgid "The time the room was created."
msgstr "Время создания номера."

msgid "Changed"
msgstr "Изменено"

msgid "The time the room was last edited."
msgstr "Время последнего редактирования номера."

msgid "Number of guests the room can accommodate (1\u201320)."
msgstr "Количество гостей, которых может разместить номер (1\u201320)."

msgid "Enter a comma-separated list of amenities. For example: Spa, Wi-Fi, TV, Parking, Minibar, Safe, Air Conditioning"
msgstr "Введите список удобств через запятую. Например: Спа, Wi-Fi, ТВ, Парковка, Мини-бар, Сейф, Кондиционер"

msgid "Room %name has been created."
msgstr "Номер \u00ab%name\u00bb создан."

msgid "Room %name has been saved."
msgstr "Номер \u00ab%name\u00bb сохранён."

